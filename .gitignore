# ==============================================================================
# VoteChain 2.0 — Comprehensive .gitignore
# Prevents node_modules, build caches, environment secrets, and private keys
# from ever being committed to GitHub.
# ==============================================================================

# --- Node & Package Manager Dependencies ---
node_modules/
*/node_modules/
client/node_modules/
.pnp
.pnp.js

# --- Environment Variables & Sensitive Files ---
.env
.env.*
!.env.example
*.env
*.secret
secrets.json
secret.json
mnemonic.txt
*.key
*.pem
*.keystore

# --- Truffle & Ganache Build Artifacts ---
build/
.truffle-history
ganache.log

# --- React / Vite Production Builds ---
dist/
dist-ssr/
client/dist/
*.local

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE & Editor Settings ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Test Coverage & Tool Caches ---
coverage/
.nyc_output/
.eslintcache
.cache/
.parcel-cache/
.turbo/
.vercel/

# --- AI Assistant / Scratch Directories ---
.gemini/

